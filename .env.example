# Server & CORS
WORKFLOW_DISPATCHER_FRONTEND_ORIGINS=*
WORKFLOW_DISPATCHER_LOG_LEVEL=INFO

# Database
WORKFLOW_DISPATCHER_DATABASE_URL=sqlite:///./github_workflow_dispatcher.sqlite
WORKFLOW_DISPATCHER_DATABASE_MIGRATE=true

# GitHub App
WORKFLOW_DISPATCHER_GITHUB_ORG=your-org
WORKFLOW_DISPATCHER_GITHUB_APP_ID=123456
WORKFLOW_DISPATCHER_GITHUB_APP_INSTALLATION_ID=0
WORKFLOW_DISPATCHER_GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Rate limiting
WORKFLOW_DISPATCHER_RATE_LIMIT_PER_SECOND=3.0
WORKFLOW_DISPATCHER_RATE_LIMIT_BURST=5
